# Development server
PORT=8788
APP_DATA_DIR=.data
STARTING_CREDITS=3

# Alibaba Cloud Model Studio, Beijing by default
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com
WAN_MODEL=wan3.0-video

# DeepSeek Shot Planner. Leave the key blank to use Codex MCP-assisted manual filling.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
